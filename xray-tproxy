#!/bin/sh /etc/rc.common
# /etc/init.d/xray-tproxy
# 先建立独立保护，再启动 Xray；通过本机检查后才允许 LAN 公网访问。

START=99
STOP=10
USE_PROCD=1

XRAY_BIN="/usr/bin/xray"
XRAY_CONF="/etc/xray/config.json"
NFT_FILE="/etc/xray/xray.nft"
GUARD_FILE="/usr/share/nftables.d/ruleset-pre/xray-guard.nft"
HEALTH_SCRIPT="/etc/xray/xray-health.sh"
ASSET_DIR="/usr/share/xray"
STATE_DIR="/var/run/xray-tproxy"
TPROXY_MARK=1
ROUTE_TABLE=100
RULE_PRIO=100
START_TIMEOUT=30

log() {
	logger -t xray-tproxy "$*"
}

health() {
	/bin/sh "$HEALTH_SCRIPT" "$@"
}

monotonic_seconds() {
	local uptime rest
	read -r uptime rest < /proc/uptime || return 1
	printf '%s\n' "${uptime%%.*}"
}

teardown_tproxy() {
	local result=0 count=0 rules
	if nft list table ip xray >/dev/null 2>&1; then
		nft delete table ip xray || result=1
	fi
	while [ "$count" -lt 32 ] &&
		ip -4 rule del priority "$RULE_PRIO" fwmark "$TPROXY_MARK" table "$ROUTE_TABLE" 2>/dev/null; do
		count=$((count + 1))
	done
	rules=$(ip -N -4 rule show) || return 1
	if printf '%s\n' "$rules" | grep -Eq '^100:.*fwmark 0x1 lookup 100([[:space:]]|$)'; then
		result=1
	fi
	if ip -4 route show table "$ROUTE_TABLE" 2>/dev/null | grep -q '^local default dev lo'; then
		ip -4 route del local 0.0.0.0/0 dev lo table "$ROUTE_TABLE" || result=1
	fi
	return "$result"
}

check_policy_conflicts() {
	local rules routes
	rules=$(ip -N -4 rule show) || return 1
	routes=$(ip -4 route show table "$ROUTE_TABLE" 2>/dev/null)
	# 不清空共享路由表；已有不同用途的 priority、mark 或 table 必须先人工解决。
	if printf '%s\n' "$rules" | awk '
		/^100:/ || /fwmark 0x1(\/[^ ]+)? / || /lookup 100( |$)/ {
			if ($0 !~ /^100:[ \t]+from all fwmark 0x1 lookup 100[ \t]*$/) bad=1
		}
		END { exit !bad }
	'; then
		log "priority 100、mark 1 或 table 100 已被其他策略使用"
		return 1
	fi
	if [ -n "$routes" ] && [ "$routes" != "local default dev lo scope host " ] &&
		[ "$routes" != "local default dev lo scope host" ]; then
		log "table 100 已有其他路由，拒绝覆盖"
		return 1
	fi
}

start_failed() {
	health fail "$*" 2>/dev/null || :
	# rc.common 不会根据 service_started 的失败自动取消 procd 重试。
	procd_kill xray-tproxy
	teardown_tproxy || log "接管规则清理未完成，请人工检查"
	log "$*；启动失败，需人工 restart（配置检查：XRAY_LOCATION_ASSET=$ASSET_DIR $XRAY_BIN run -test -config $XRAY_CONF）"
	return 1
}

start_service() {
	local command
	START_OK=0
	for command in nft ip ubus jsonfilter flock awk od readlink cmp uci; do
		command -v "$command" >/dev/null 2>&1 || { log "缺少命令：$command"; return 1; }
	done
	[ -x "$XRAY_BIN" ] && [ -r "$XRAY_CONF" ] && [ -r "$NFT_FILE" ] &&
		[ -r "$GUARD_FILE" ] && [ -r "$HEALTH_SCRIPT" ] || {
		log "Xray 二进制或项目文件不完整"; return 1;
	}
	# flow offload 会绕过 PREROUTING / FORWARD，必须先关闭并重载 fw4。
	health preflight || { log "防火墙或流量卸载检查失败，请关闭流量卸载并重载 fw4"; return 1; }
	# 与 fw4 存在性校验处于同一事务；reload 也会加载同一保护文件。
	health protect || return 1
	health prepare || return 1
	check_policy_conflicts || return 1
	teardown_tproxy || return 1
	START_OK=1
	procd_open_instance xray
	procd_set_param command "$XRAY_BIN" run -config "$XRAY_CONF"
	procd_set_param env XRAY_LOCATION_ASSET="$ASSET_DIR"
	procd_set_param limits nofile="65535 65535"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance health
	procd_set_param command /bin/sh "$HEALTH_SCRIPT" monitor
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_started() {
	local started now
	[ "$START_OK" = 1 ] || { procd_kill xray-tproxy; return 1; }
	# 使用单调时钟，检查本身耗时也计入 30 秒，不按 sleep 次数估计。
	started=$(monotonic_seconds) || { start_failed "无法读取单调时钟"; return 1; }
	while :; do
		if health check; then
			now=$(monotonic_seconds) || { start_failed "无法读取单调时钟"; return 1; }
			[ "$((now - started))" -lt "$START_TIMEOUT" ] && break
		fi
		now=$(monotonic_seconds) || { start_failed "无法读取单调时钟"; return 1; }
		if [ "$((now - started))" -ge "$START_TIMEOUT" ]; then
			start_failed "30 秒内本机入口未就绪"
			return 1
		fi
		sleep 1
	done
	if ip -4 route add local 0.0.0.0/0 dev lo table "$ROUTE_TABLE" &&
		ip -4 rule add fwmark "$TPROXY_MARK" table "$ROUTE_TABLE" priority "$RULE_PRIO" &&
		nft -f "$NFT_FILE" &&
		now=$(monotonic_seconds) && [ "$((now - started))" -lt "$START_TIMEOUT" ] &&
		health activate "$((started + START_TIMEOUT))" &&
		now=$(monotonic_seconds) && [ "$((now - started))" -lt "$START_TIMEOUT" ]; then
		log "TPROXY 规则已加载，本机检查通过"
	else
		start_failed "接管规则安装或核验失败"
		return 1
	fi
}

stop_service() {
	local i=0
	# 独立停止标记无需等待检查锁；迟到的检查不能再开始发放许可。
	mkdir -p "$STATE_DIR" && : > "$STATE_DIR/stop-request"
	# 等正在进行的检查离开临界区；不会删除保护表。
	while ! health stop; do
		i=$((i + 1))
		if [ "$i" -ge 10 ]; then
			log "检查锁或许可清理异常；停止进程后仍由 6 秒许可到期兜底"
			break
		fi
		sleep 1
	done
}

service_stopped() {
	# 此时 procd 已取消两个实例和后续重试；保护表仍保留。
	teardown_tproxy || log "接管规则清理未完成，请人工检查"
}

status_service() {
	local phase
	phase=$(cat "$STATE_DIR/phase" 2>/dev/null)
	printf 'xray-tproxy: %s\n' "${phase:-stopped}"
	[ "$phase" = running ] && procd_running xray-tproxy xray
}

reload_service() {
	restart
}
