{
  "log": {
    "access": "none",
    "error": "none",
    "loglevel": "none",
    "dnsLog": true,
    "maskAddress": ""
  },
  "dns": {
    "hosts": {
      "domain:googleapis.cn": ["googleapis.com"],
      "dns.alidns.com": [
        "223.5.5.5",
        "223.6.6.6",
        "2400:3200::1",
        "2400:3200:baba::1"
      ]
    },
    "servers": [
      {
        "address": "8.8.8.8",
        "tag": "dns-google-1"
      },
      {
        "address": "https+local://dns.alidns.com/dns-query",
        "domains": [
          "xxxx.com",
          "ext:loyalsoldier_geosite.dat:private",
          "ext:loyalsoldier_geosite.dat:category-game-platforms-download@cn"
        ],
        "skipFallback": true,
        "tag": "dns-ali-1"
      },
      {
        "address": "8.8.8.8",
        "domains": ["ext:loyalsoldier_geosite.dat:geolocation-!cn"],
        "skipFallback": true,
        "tag": "dns-google-2"
      },
      {
        "address": "https+local://dns.alidns.com/dns-query",
        "domains": ["ext:loyalsoldier_geosite.dat:cn"],
        "expectedIPs": ["ext:loyalsoldier_geoip-only-cn-private.dat:cn"],
        "skipFallback": true,
        "tag": "dns-ali-2"
      }
    ],
    "tag": "dns-module",
    "queryStrategy": "UseIPv4",
    "useSystemHosts": false
  },
  "inbounds": [
    {
      "tag": "in-tproxy",
      "listen": "0.0.0.0",
      "port": 12345,
      "protocol": "tunnel",
      "settings": {
        "allowedNetwork": "tcp,udp",
        "followRedirect": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "metadataOnly": false,
        "routeOnly": true
      }
    },
    {
      "tag": "in-dns",
      "listen": "127.0.0.1",
      "port": 5300,
      "protocol": "tunnel",
      "settings": {
        "allowedNetwork": "tcp,udp",
        "rewriteAddress": "8.8.8.8",
        "rewritePort": 53
      }
    }
  ],
  "outbounds": [
    {
      "tag": "out-proxy",
      "protocol": "vless",
      "settings": {
        "address": "xxxx.com",
        "port": 443,
        "id": "xxxx-xxxx-xxxx-xxxx",
        "flow": "",
        "encryption": "none"
      },
      "streamSettings": {
        "method": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "xxxx.com",
          "fingerprint": "chrome",
          "alpn": ["h2"],
          "show": false
        },
        "xhttpSettings": {
          "mode": "auto",
          "host": "xxxx.com",
          "path": "/xxxx",
          "extra": {}
        },
        "sockopt": {
          "mark": 255
        }
      }
    },
    {
      "tag": "out-direct",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "mark": 255,
          "domainStrategy": "UseIPv4"
        }
      }
    },
    {
      "tag": "out-block",
      "protocol": "blackhole"
    },
    {
      "tag": "out-dns",
      "protocol": "dns",
      "settings": {
        "rewriteAddress": "8.8.8.8",
        "rewritePort": 53,
        "rules": [
          {
            "qType": "1,28",
            "action": "hijack"
          },
          {
            "qType": 65,
            "action": "return",
            "rCode": 5
          },
          {
            "action": "direct"
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "out-proxy"
        }
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "inboundTag": ["dns-module"],
        "outboundTag": "out-proxy"
      },
      {
        "inboundTag": ["in-dns"],
        "outboundTag": "out-dns"
      },
      {
        "inboundTag": ["in-tproxy"],
        "port": "53",
        "outboundTag": "out-dns"
      },
      {
        "domain": ["ext:loyalsoldier_geosite.dat:private"],
        "outboundTag": "out-direct"
      },
      {
        "ip": ["ext:loyalsoldier_geoip-only-cn-private.dat:private"],
        "outboundTag": "out-direct"
      },
      {
        "network": "udp",
        "port": "443",
        "outboundTag": "out-block"
      },
      {
        "network": "tcp,udp",
        "port": "853",
        "outboundTag": "out-block"
      },
      {
        "protocol": ["bittorrent"],
        "outboundTag": "out-direct"
      },
      {
        "domain": [
          "xxxx.com",
          "ext:loyalsoldier_geosite.dat:category-game-platforms-download@cn"
        ],
        "outboundTag": "out-direct"
      },
      {
        "domain": ["ext:loyalsoldier_geosite.dat:geolocation-!cn"],
        "outboundTag": "out-proxy"
      },
      {
        "domain": ["ext:loyalsoldier_geosite.dat:cn"],
        "outboundTag": "out-direct"
      },
      {
        "ip": ["ext:loyalsoldier_geoip-only-cn-private.dat:cn"],
        "outboundTag": "out-direct"
      }
    ]
  }
}
